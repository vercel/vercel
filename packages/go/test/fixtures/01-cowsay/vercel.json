{
  "version": 2,
  "builds": [
    { "src": "index.go", "use": "@vercel/go" },
    { "src": "subdirectory/index.go", "use": "@vercel/go" }
  ],
  "probes": [
    { "path": "/", "mustContain": "cow:go1.27." },
    { "path": "/", "mustContain": ":RANDOMNESS_PLACEHOLDER" },
    { "path": "/subdirectory", "mustContain": "subcow:go1.27." },
    { "path": "/subdirectory", "mustContain": ":RANDOMNESS_PLACEHOLDER" }
  ]
}
