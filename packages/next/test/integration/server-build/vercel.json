{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next",
      "config": {
        "functions": {
          "pages/index.js": {
            "memory": 512,
            "maxDuration": 5,
            "maxConcurrency": 2
          },
          "pages/another.js": {
            "memory": 512,
            "maxDuration": 5
          },
          "pages/api/index.js": {
            "memory": 128,
            "maxDuration": 5,
            "maxConcurrency": 6
          },
          "pages/dynamic/[slug].js": {
            "maxDuration": 5,
            "maxConcurrency": 4
          },
          "**/*.js": {
            "maxDuration": 5
          }
        }
      }
    }
  ]
}
