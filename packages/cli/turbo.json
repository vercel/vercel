{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [
        "dist/**",
        "src/util/constants.ts",
        "src/util/dev/templates/*.ts"
      ]
    },
    "build-binary": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "build-binary:host": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "test-e2e": {
      "dependsOn": []
    },
    "test-unit": {
      "dependsOn": ["build"]
    }
  }
}
