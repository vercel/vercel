{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": [
        "@vercel-internals/builder-orchestration#build",
        "@vercel-internals/cli-builder-integration#build",
        "@vercel-internals/get-package-json#build",
        "@vercel-internals/local-schedules#build",
        "@vercel-internals/service-topology#build",
        "@vercel/build-utils#build",
        "@vercel/client#build",
        "@vercel/fs-detectors#build",
        "@vercel/routing-utils#build"
      ],
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/skills/vercel-cli/**"],
      "outputs": [
        "dist/**",
        "src/util/constants.ts",
        "src/util/dev/templates/*.ts"
      ]
    },
    "build-binary": {
      "cache": false,
      "dependsOn": ["build:package"]
    },
    "build-binary:host": {
      "cache": false,
      "dependsOn": ["build:package"]
    },
    "test": {
      "dependsOn": ["build:package", "//#generate:cache-keys"]
    },
    "test-e2e": {
      "dependsOn": ["//#generate:cache-keys"]
    },
    "test-build-integration": {
      "dependsOn": ["build:package", "//#generate:cache-keys"]
    },
    "test-e2e-artifacts": {
      "command": [
        "node",
        "scripts/test.mjs",
        "--run",
        "test/e2e-curl-deploy.test.ts",
        "test/e2e-curl-deploy-no-framework.test.ts"
      ],
      "dependsOn": ["//#generate:cache-keys"]
    },
    "test-dev-artifacts": {
      "command": ["pnpm", "run", "test-dev"]
    },
    "test-testserver": {
      "cache": false,
      "dependsOn": ["build:package"]
    },
    "test-unit": {
      // Vercel CI runs each turbo task in one VM (2 CPUs by default), so this
      // suite gets 16 CPUs and vitest spreads its files across them. GitHub
      // Actions instead splits it into 7 jobs with VITEST_SHARD. Splitting it
      // into per-area turbo tasks with narrow inputs is a possible follow-up.
      "tags": ["ci", "ci:cpus:16"],
      "dependsOn": ["build:package", "//#generate:cache-keys"],
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/skills/vercel-cli/**",
        "$TURBO_ROOT$/.github/workflows/pr-binaries.yml"
      ]
    }
  }
}
