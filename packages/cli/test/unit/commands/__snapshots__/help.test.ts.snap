exports[`help command > teams help output snapshots > teams help column width 40 1`] = `
"▲ vercel teams <command>
Manage Teams under your Vercel account

Commands:
  create
    Create a new team
  invite [email]...
    Invite a new member to a team
    (prompts for emails when none are
    given, except in non-interactive
    mode)
  list
    Show all teams that you're a member
    of
  request [userId]
    Show join-request status for the
    current team (default: the
    authenticated user)
  switch [name]
    Switch to a different team
  sso
    Show SAML / SSO configuration for
    the current team
  members
    List, invite, or remove members from
    the current team

Global Options: See \`vercel --help\`
"
`;

