  -n, --limit <NUMBER>  Number of candidates to check per page (default: 20, max: 200)
  --next <CURSOR>       Show the next page of candidates
  --order <ORDER>       Order candidates by relevance, alphabetical order, or length (default: relevance)
  --tld <TLD>           Filter candidates by exact TLD. Repeatable.

Global Options: See \`vercel --help\`

Examples:
  Discover domain-name candidates
    vercel domains search acme

  Narrow candidates with a TLD fragment
    vercel domains search acme.d

  Filter candidates by TLD
    vercel domains search acme --tld com --tld dev

  Show only available candidates
    vercel domains search acme --available

  JSON output
    vercel domains search acme --json
"
`;

exports[`help command > domains help output snapshots > domains transfer-in help output snapshots > domains transfer-in help column width 120 1`] = `
"▲ vercel domains transfer-in <domain>
Transfer in a domain name to Vercel

Global Options: See \`vercel --help\`
"
`;

exports[`help command > domains help output snapshots > domains verify help output snapshots > domains verify help column width 120 1`] = `
"▲ vercel domains verify <domain> [options]
Check a domain's DNS configuration and explain what to fix when it is misconfigured or unverified

Options:
  --json                      Output as JSON
  -p, --project <NAME_OR_ID>  Project name or ID (default: linked project)
  --strict                    Check DNS for the exact domain only, without falling back to the parent zone configuration

Global Options: See \`vercel --help\`

Examples:
  Check why a domain is not working
    vercel domains verify example.com

  Check a domain against a specific project
    vercel domains verify example.com --project my-site

  JSON output (the exit code is non-zero when the domain is misconfigured or unverified)
    vercel domains verify example.com --json

  Agent-friendly output with status, reason, and suggested next commands
    vercel domains verify example.com --non-interactive
"
`;

exports[`help command > env help output snapshots > env add help output snapshots > env add help column width 120 1`] = `
"▲ vercel env add <name> [options]
Add an Environment Variable

Options:
  -e, --environment <ENVIRONMENT>  Environments to add the variable to; repeatable or comma-separated. Prompts when
                                   omitted
  --force                          Overwrite an existing variable in the same environment
  --git-branch <BRANCH>            Set the Git branch for a Preview Environment Variable
  --guidance                       Show command suggestions after completion
  --no-sensitive                   Store the value as Config
  -p, --project <NAME_OR_ID>       Project name or ID (default: linked project)
  --sensitive                      Store the value as a Secret
  --type <TYPE>                    Set the Environment Variable type (\`config\` or \`secret\`)
  --value <VALUE>                  Set the variable value for non-interactive use; otherwise use stdin or the prompt
  -y, --yes                        Accept default choices when adding an Environment Variable

Global Options: See \`vercel --help\`

Examples:
  Add a new variable (prompts for value and Environments)
    vercel env add <name>

  Add a new Environment Variable to a specific Environment
    vercel env add <name> --environment <production | preview | development>

  Add one variable to multiple Environments (comma-separated)
    vercel env add <name> --environment <environment>[,<environment>]

  Override an existing Environment Variable in the same environment (production, preview, development)
    vercel env add API_TOKEN --force

  Add a Config Environment Variable that remains readable later
    vercel env add API_TOKEN --no-sensitive

  Add a new Environment Variable for a specific Environment and Git Branch
    vercel env add <name> --environment <production | preview | development> --git-branch <BRANCH>

  Add a variable from piped input
    cat <file> | vercel env add <name> --environment <production | preview | development>

  Add a variable from a file
    vercel env add <name> --environment <production | preview | development> < <file>

  Add with --value for non-interactive use
    vercel env add API_TOKEN --environment production --value "<value>" --yes
"
`;

exports[`help command > env help output snapshots > env help column width 40 1`] = `
"▲ vercel env <command>
Interact with Environment Variables for
a Project

Commands:
  add <name>
    Add an Environment Variable
  list
    List all Environment Variables for a
    Project
  pull [filename]
    Pull Environment Variables into a
    local file (default: .env.local)
  remove <name>
    Remove an Environment Variable (see
    examples below)
  run <command>...
    Run a command with environment
    variables from the linked Vercel
    project
  update <name>
    Update the value of an existing
    Environment Variable (see examples
    below)

Global Options: See \`vercel --help\`

Examples:
  Run a command with Environment
  Variables from the linked Project
    vercel env run -- <command>

  Add one variable to multiple
  Environments
    vercel env add API_URL --environment production,preview,development
"
`;

