exports[`help command > dev help output snapshots > dev --help > outputs help 1`] = `
"▲ vercel dev [dir] [options]
Starts the \`vercel dev\` server.

Options:
  --listen <URI>               Specify a URI endpoint on which to listen
                               (default: 0.0.0.0:3000)
  --local                      Start the dev server without linking to a Vercel
                               project
  --project <NAME_OR_ID>       Project name or ID (default: linked project)
  --queue-port <PORT>          Specify the local Vercel Queues server port
                               (default: 4782)
  --runtime-cache-port <PORT>  Specify the local Runtime Cache server port
                               (default: 4783)
  --schedules-port <PORT>      Specify the local Vercel Schedules server port
                               (default: 4784)
  -y, --yes                    Accept default value for all prompts

Global Options: See \`vercel --help\`

Examples:
  Start the \`vercel dev\` server on port 8080
    vercel dev --listen 8080

  Make the \`vercel dev\` server bind to localhost on port 5000
    vercel dev --listen 127.0.0.1:5000 

  Pin local resource server ports
    vercel dev --queue-port 5782 --runtime-cache-port 5783 --schedules-port 5784
"
`;

exports[`help command > dns help output snapshots > dns add help output snapshots > dns add help column width 120 1`] = `
"▲ vercel dns add <domain> <details>
Add a DNS record

Arguments:
  <domain>
  <details>  Record name, type, and value

Global Options: See \`vercel --help\`

Record Types:
  A, AAAA, ALIAS, CAA, CNAME, MX, SRV, TXT
"
`;

exports[`help command > dns help output snapshots > dns help column width 40 1`] = `
"▲ vercel dns [command]
Manage DNS records for your domains

Commands:
  add <domain> <details>
    Add a DNS record
  import <domain> <zonefile>
    Import a DNS zone file (see below
    for examples)
  inspect <id>
    Show a DNS record in full using its
    ID
  list [domain]
    List DNS entries. Pass a domain to
    list its records, or omit the
    argument to list records across
    every domain on the scope (default)
  remove <id>
    Remove a DNS entry using its ID
  update <id>
    Update an existing DNS record using
    its ID

Global Options: See \`vercel --help\`

Examples:
  Add an A record for a subdomain
    vercel dns add <DOMAIN> <SUBDOMAIN> A <VALUE>

  Add an MX record (@ as a name refers
  to the domain)
    vercel dns add <DOMAIN> '@' MX <RECORD VALUE> <PRIORITY>

  Add an SRV record
    vercel dns add <DOMAIN> <NAME> SRV <PRIORITY> <WEIGHT> <PORT> <TARGET>

  Add a CAA record
    vercel dns add <DOMAIN> <NAME> CAA '<FLAGS> <TAG> "<VALUE>"'

  Update a DNS record value
    vercel dns update <ID> --value <VALUE>

  Update a DNS record name and TTL
    vercel dns update <ID> --name <NAME> --ttl <SECONDS>

  Show a DNS record in full using its ID
    vercel dns inspect <ID>

  Import a Zone file
    vercel dns import <DOMAIN> <FILE>

  Get the next page of DNS records
    vercel dns list --next <CURSOR>

  Get the next page for a domain
    vercel dns list <DOMAIN> --next <CURSOR>

Record Types:
  A, AAAA, ALIAS, CAA, CNAME, MX, SRV,
  TXT
"
`;

