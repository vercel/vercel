exports[`help command > list help output snapshots > list help column width 40 1`] = `
"▲ vercel list [app] [options]
List deployments.

Options:
  -a, --all
    List resources across all projects
  -e, --environment <ENVIRONMENT>
    Filter deployments by environment
  --json
    Output as JSON
  -n, --limit <NUMBER>
    Number of results to return per page
    (default: 20, max: 100)
  --meta <KEY=VALUE>
    Filter deployments by metadata (e.g.
    \`--meta KEY=value\`). Can appear many
    times.
  --next <CURSOR>
    Show the next page using the cursor
    from the previous output
  --policy <KEY=VALUE>
    See deployments with provided
    Deployment Retention policies (e.g.
    \`--policy KEY=value\`). Can appear
    many times.
  --status <STATUS>
    Filter deployments by their status.
    Can be comma-separated for multiple
    statuses (e.g.: \`--status
    BUILDING,READY\`)
  -y, --yes
    Accept default value for all prompts

Global Options: See \`vercel --help\`

Examples:
  List all deployments for the currently
  linked project
    vercel list

  List all deployments across all
  projects
    vercel list --all

  List all deployments for the project
  \`my-app\`
    vercel list my-app

  Filter deployments by metadata
    vercel list --meta key1=value1 --meta key2=value2

  Show the next page, using the cursor
  from the previous output
    vercel list my-app --next <CURSOR>

  Filter deployments by status
    vercel list --status READY

  Filter deployments by multiple
  statuses
    vercel list --status BUILDING,ERROR
"
`;

