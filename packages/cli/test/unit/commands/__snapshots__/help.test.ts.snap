exports[`help command > qualifies storage 'connect' previews when variable names are unavailable 1`] = `
"▲ vercel storage connect <store> [options]
Connect a storage resource (Blob, Global Config, Marketplace, or first-party) to a project

Options:
  --add-rw-token                   Blob only: explicitly write the static read-write token env var. Required for --auth
                                   token, and additive on top of --auth oidc.
  --auth <MODE>                    Credential mode: \`oidc\` or \`token\` (default: \`oidc\`). Blob only: \`token\` writes
                                   long-lived credentials and requires --add-rw-token. Other stores use the credentials
                                   their provider issues.
  --dry-run                        Preview connection changes without applying them (provider variable names may be
                                   unavailable)
  -e, --environment <ENVIRONMENT>  Environment to connect (repeatable: production, preview, development) (default: all
                                   three).
  --json                           Output as JSON
  --prefix <PREFIX>                Prefix for the generated environment variable names (e.g. --prefix UPLOADS writes
                                   UPLOADS_STORE_ID)
  -p, --project <NAME_OR_ID>       Project name or ID (default: linked project)
  -y, --yes                        Skip the confirmation prompt when connecting a resource

Global Options: See \`vercel --help\`

Examples:
  Connect a store to the linked project in every environment
    vercel storage connect <store>

  Connect to a specific project and environments
    vercel storage connect my-blob-store --project my-app --environment production --environment preview

  Preview the connection and Environment Variable changes
    vercel storage connect my-blob-store --dry-run
    vercel storage connect my-blob-store --dry-run --json

  Opt in to the static read-write token alongside OIDC
    vercel storage connect my-blob-store --add-rw-token --yes

  Use only static credentials (requires the explicit opt-in)
    vercel storage connect my-blob-store --auth token --add-rw-token --yes
"
`;

exports[`help command > redeploy help output snapshots > redeploy help column width 40 1`] = `
"▲ vercel redeploy <deployment> [options]
Rebuild and deploy a previous
deployment.

Options:
  -e, --environment <ENVIRONMENT>
    Environment to redeploy to:
    production, preview, or a custom
    environment (default: the original
    deployment's environment)
  --no-wait
    Don't wait for the redeploy to
    finish

Global Options: See \`vercel --help\`

Examples:
  Rebuild and deploy an existing
  deployment using id or url
    vercel redeploy my-deployment.vercel.app

  Write Deployment URL to a file
    vercel redeploy my-deployment.vercel.app > deployment-url.txt

  Rebuild and deploy an existing
  deployment to a specific environment
    vercel redeploy my-deployment.vercel.app --environment preview
"
`;

