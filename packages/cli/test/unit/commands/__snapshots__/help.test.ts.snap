exports[`help command > whoami help output snapshots > whoami help column width 40 1`] = `
"▲ vercel whoami [options]
Shows the username of the currently
logged in user.

Options:
  --cached  Print the username saved by
            the last check, without
            contacting Vercel. It can be
            out of date.
  --json    Output as JSON

Global Options: See \`vercel --help\`

Examples:
  Shows the username of the currently
  logged in user
    vercel whoami

  Print the saved username without a
  network request
    vercel whoami --cached
"
`;

