exports[`help command > bisect help output snapshots > bisect help column width 40 1`] = `
"▲ vercel bisect [options]
Bisect the current project interactively
or via an automated test script.

Options:
  --bad <URL>
    Known bad URL
  --good <URL>
    Known good URL
  --open <URL>
    Automatically open each URL in the
    browser
  --path <PATH>
    Subpath of the deployment URL to
    test
  --run <SCRIPT>
    Test script to run for each
    deployment

Global Options: See \`vercel --help\`

Examples:
  Bisect the current project
  interactively
    vercel bisect

  Bisect with a known bad deployment
    vercel bisect --bad example-310pce9i0.vercel.app

  Automated bisect with a run script
    vercel bisect --run ./test.sh
"
`;

