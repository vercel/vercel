exports[`help command > project help output snapshots > project help column width 40 1`] = `
"▲ vercel project [command]
Manage your Vercel projects

Commands:
  create <name>
    Create a new project
  access-summary [name]
    Show member counts by team role for
    project access (requires access
    groups entitlement)
  checks [name]
    List, add, or remove deployment
    checks for a project
  inspect [name]
    Displays information related to a
    project
  list
    Show all projects in the selected
    scope (default)
  members [name]
    List, add, or remove project members
    for a project
  access-groups [name]
    List access groups for a project
  protection [name]
    Show or toggle deployment protection
    settings for a project
  web-analytics
    Enable or disable Web Analytics for
    a project
  speed-insights
    Enable or disable Speed Insights for
    a project
  pause [project]
    Pause production traffic for a
    project (visitors will see an error
    page)
  observability
    Enable or disable Observability Plus
    for a project
  priority
    Upgrade a project to Priority, or
    remove that upgrade
  resume [project]...
    Resume production traffic for paused
    projects
  update [name]
    Update one or more project settings;
    omitted settings remain unchanged
  rename <name> <new-name>
    Rename a project
  delete <name>
    Delete a project
  token [name]
    Get a development OIDC token for a
    project

Global Options: See \`vercel --help\`

Examples:
  List projects in the current scope
    vercel project list

  Inspect a project
    vercel project inspect my-project

  Pause production traffic for a project
    vercel project pause my-project
"
`;

