exports[`help command > domains help output snapshots > domains add help output snapshots > domains add help column width 120 1`] = `
"▲ vercel domains add <domain> [project] [options]
Add a domain you already own to your team or a project

Arguments:
  <domain>   Domain name, such as example.com
  [project]  Optional project name; omit to add an apex domain to the team

Options:
  --force  Remove the current assignment, then add the domain to the requested project (a failed add can leave it
           unassigned)

Global Options: See \`vercel --help\`

Examples:
  Add a domain that you already own
    vercel domains add domain-name.com

DNS Configuration:
  Without a project, adds an apex domain to your team and creates its DNS zone. To use Vercel DNS, configure the
  domain's nameservers at your registrar.
  With a project, assigns the domain to it. External DNS providers are supported; follow the project's DNS configuration
  instructions.
  \`vercel alias\` can add an existing domain to your team while assigning it to a deployment, so a separate \`domains add\`
  step may not be needed.
"
`;

exports[`help command > domains help output snapshots > domains buy help output snapshots > domains buy help column width 120 1`] = `
"▲ vercel domains buy <domain> [options]
Purchase a new domain name

Options:
  --address <TEXT>       Registrant street address
  --amount <USD>         Price a person approved for this charge, in USD. Required without a terminal; nothing is
                         charged if the price changed
  --auto-renew           Renew the domain automatically at the end of each term. Without a terminal, pass --auto-renew
                         or --no-auto-renew
  --city <TEXT>          Registrant city
  --company <TEXT>       Registrant company name (optional)
  --country <TEXT>       Registrant 2-letter country code, such as US
  --email <TEXT>         Registrant email
  --first-name <TEXT>    Registrant first name
  --json                 Output as JSON
  --last-name <TEXT>     Registrant last name
  --no-auto-renew        Don't renew the domain automatically
  --phone <TEXT>         Registrant phone with country code, such as +11122233344
  --state <TEXT>         Registrant state or province
  --use-billing-details  Fill registrant details you don't pass from the team's billing info (email and address). An
                         address option that replaces a billing value skips the whole billing address
  --zip <TEXT>           Registrant postal or ZIP code

Global Options: See \`vercel --help\`

Examples:
  Buy a domain (shows the price and asks for contact details)
    vercel domains buy example.com

  From an agent or script: buy at the price a person approved, with the billing info for the address
    vercel domains buy example.com --scope my-team --amount 20.00 --use-billing-details --first-name Jane --last-name Doe --phone +11122233344 --no-auto-renew
"
`;

exports[`help command > domains help output snapshots > domains check help output snapshots > domains check help column width 120 1`] = `
"▲ vercel domains check <domain>... [options]
Check whether one or more domains are available to buy

Options:
  --json  Output as JSON

Global Options: See \`vercel --help\`

Examples:
  Check if a domain is available
    vercel domains check example.com

  Check availability for multiple domains
    vercel domains check one.com two.com three.com

  JSON output
    vercel domains check example.com --json
"
`;

exports[`help command > domains help output snapshots > domains help column width 40 1`] = `
"▲ vercel domains [command]
Manage domains

Commands:
  list
    Show all domains in a list (default)
  inspect <domain>
    Displays information related to a
    domain
  add <domain> [project]
    Add a domain you already own to your
    team or a project
  buy <domain>
    Purchase a new domain name
  check <domain>...
    Check whether one or more domains
    are available to buy
  move <domain> <destination>
    Move ownership of a domain name to
    another Vercel Team
  price <domain>...
    Show registrar price quotes for one
    or more domains
  search <query>
    Discover domain-name candidates from
    a keyword or fragment
  transfer-in <domain>
    Transfer in a domain name to Vercel
  remove <domain>
    Remove ownership of a domain name
    from a Vercel Team
  renew <domain>
    Renew a registered domain before it
    expires (charges your account)
  auto-renew
    Turn automatic renewal on or off for
    a registered domain
  verify <domain>
    Check a domain's DNS configuration
    and explain what to fix when it is
    misconfigured or unverified

Global Options: See \`vercel --help\`

Examples:
  Renew a registered domain before it
  expires
    vercel domains renew <DOMAIN>

  Turn on automatic renewal for a
  registered domain
    vercel domains auto-renew enable <DOMAIN>
"
`;

