exports[`help command > certs help output snapshots > certs help column width 40 1`] = `
"▲ vercel certs <command>
Interact with SSL certificates. This
command is intended for advanced use
only. By default, Vercel manages your
certificates automatically.

Commands:
  add
    Add a new certificate
  issue <cn>
    Issue a new certificate for a domain
  list
    Show all available certificates
  delete <id>
    Delete a certificate by id

Global Options: See \`vercel --help\`

Examples:
  Generate a certificate with the cnames
  "acme.com" and "www.acme.com"\`
    vercel certs issue acme.com www.acme.com

  Delete a certificate
    vercel certs delete id

  Show the next page, using the cursor
  from the previous output
    vercel certs list --next <CURSOR>
"
`;

