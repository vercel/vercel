exports[`help command > pull help output snapshots > pull help column width 40 1`] = `
"▲ vercel pull [project-path] [options]
Pull Environment Variables and project
settings into .vercel

Options:
  -e, --environment <ENVIRONMENT>
    Deployment environment (default:
    development)
  --git-branch <BRANCH>
    Specify the Git branch to pull
    specific Environment Variables for
  -p, --project <NAME_OR_ID>
    Project name or ID (default: linked
    project)
  -y, --yes
    Skip questions when setting up new
    project using default scope and
    settings

Global Options: See \`vercel --help\`

Examples:
  Pull the latest Environment Variables
  and Project Settings from the cloud
    vercel pull

  Pull the latest Environment Variables
  and Project Settings from the cloud
  targeting a directory
    vercel pull ./path-to-project

  Pull for a specific environment
    vercel pull --environment=<production | preview | development>

  Pull for a preview feature branch
    vercel pull --environment=preview --git-branch=feature-branch

  Pull Environment Variables into an
  application env file with \`vercel env
  pull\`
    vercel env pull
"
`;

