// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ci help > documents disable at 40 columns 1`] = `
"▲ vercel ci disable [options]
Disable Vercel CI for the current
repository. The repository must be
connected to a project on the current
team

Options:
  --json
    Output as JSON
  --remote <NAME>
    Git remote to disable Vercel CI for
    (default: the only remote; prompts
    when multiple exist). Required with
    multiple remotes in non-interactive
    mode

Global Options: See \`vercel --help\`

Examples:
  Disable Vercel CI for the current
  repository
    vercel ci disable

  Disable Vercel CI for a repository on
  another team
    vercel ci disable --scope <TEAM>

  Disable Vercel CI for a specific Git
  remote without prompts
    vercel ci disable --remote upstream --non-interactive
"
`;

exports[`ci help > documents disable at 80 columns 1`] = `
"▲ vercel ci disable [options]
Disable Vercel CI for the current repository. The repository must be connected
to a project on the current team

Options:
  --json           Output as JSON
  --remote <NAME>  Git remote to disable Vercel CI for (default: the only
                   remote; prompts when multiple exist). Required with multiple
                   remotes in non-interactive mode

Global Options: See \`vercel --help\`

Examples:
  Disable Vercel CI for the current repository
    vercel ci disable

  Disable Vercel CI for a repository on another team
    vercel ci disable --scope <TEAM>

  Disable Vercel CI for a specific Git remote without prompts
    vercel ci disable --remote upstream --non-interactive
"
`;

exports[`ci help > documents disable at 120 columns 1`] = `
"▲ vercel ci disable [options]
Disable Vercel CI for the current repository. The repository must be connected to a project on the current team

Options:
  --json           Output as JSON
  --remote <NAME>  Git remote to disable Vercel CI for (default: the only remote; prompts when multiple exist). Required
                   with multiple remotes in non-interactive mode

Global Options: See \`vercel --help\`

Examples:
  Disable Vercel CI for the current repository
    vercel ci disable

  Disable Vercel CI for a repository on another team
