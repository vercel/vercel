{
  "schedules": {
    "daily-report": {
      "timezone": "America/New_York",
      "schedule": "0 0 * * *",
      "function": "api/scheduled-job"
    },
    "hourly-jobs": {
      "schedule": "0 * * * *",
      "jitter": 5,
      "topic": "hourly-jobs"
    },
    "every-ten": {
      "schedule": "*/10 * * * *",
      "jitter": 15,
      "topic": "every-ten"
    },
    "minimum-jitter": {
      "schedule": "*/10 * * * *",
      "jitter": 1,
      "topic": "minimum-jitter"
    }
  }
}
