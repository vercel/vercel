[
  {
    "handle": "filesystem"
  },
  {
    "src": "^(?:\\/template)(?:\\/$)?$",
    "dest": "/template",
    "methods": [
      "GET"
    ]
  },
  {
    "src": "/(.*)",
    "dest": "/",
    "transforms": [
      {
        "type": "request.path",
        "op": "set",
        "args": "/$1"
      }
    ]
  }
]