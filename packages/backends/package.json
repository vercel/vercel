{
  "name": "@vercel/backends",
  "version": "0.8.30",
  "license": "Apache-2.0",
  "main": "./dist/index.mjs",
  "homepage": "https://vercel.com/docs",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json",
    "./rolldown/esm": "./dist/rolldown/esm.mjs",
    "./rolldown/hooks": "./dist/rolldown/hooks.mjs",
    "./rolldown/cjs-hooks": "./dist/rolldown/cjs-hooks.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel/vercel.git",
    "directory": "packages/backends"
  },
  "scripts": {
    "build": "tsdown",
    "vitest-run": "vitest -c ../../vitest.config.mts",
    "vitest": "tsdown && vitest",
    "vitest-unit": "glob --absolute 'test/unit.*test.ts'",
    "type-check": "tsc --noEmit"
  },
  "files": [
    "dist",
    "templates"
  ],
  "dependencies": {
    "@vercel/build-utils": "workspace:*",
    "@vercel/nft": "1.11.0",
    "@vercel/static-config": "workspace:*",
    "execa": "3.2.0",
    "fs-extra": "11.4.0",
    "get-port": "5.1.1",
    "oxc-transform": "0.148.0",
    "path-to-regexp": "8.4.2",
    "resolve.exports": "2.0.3",
    "rolldown": "1.2.7",
    "srvx": "1.0.1",
    "ts-morph": "12.0.0",
    "tsx": "4.23.13",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/fs-extra": "11",
    "@types/js-yaml": "3.12.1",
    "@types/node": "20.11.0",
    "hono": "4.13.5",
    "tsdown": "0.22.14",
    "vite": "^5.1.6",
    "vitest": "^2.0.1",
    "typescript": "5.9.3"
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts"
}
