{
  "name": "@vercel/functions",
  "description": "Runtime functions to be used with your Vercel Functions",
  "homepage": "https://vercel.com/docs/functions/functions-api-reference/vercel-functions-package",
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "**/*.md"
  ],
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": "./index.js",
      "require": "./index.js"
    },
    "./headers": {
      "import": "./headers.js",
      "require": "./headers.js"
    },
    "./oidc": {
      "import": "./oidc/index.js",
      "require": "./oidc/index.js"
    },
    "./db-connections": {
      "import": "./db-connections/index.js",
      "require": "./db-connections/index.js"
    },
    "./middleware": {
      "import": "./middleware.js",
      "require": "./middleware.js"
    }
  },
  "version": "3.7.6",
  "repository": {
    "directory": "packages/functions",
    "type": "git",
    "url": "git+https://github.com/vercel/vercel.git"
  },
  "bugs": {
    "url": "https://github.com/vercel/vercel/issues"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1125.0",
    "@aws-sdk/credential-provider-web-identity": "3.972.76",
    "@smithy/types": "3.3.0",
    "@types/pg": "8.15.5",
    "@types/ws": "8.18.1",
    "cassandra-driver": "4.9.0",
    "ioredis": "5.6.1",
    "mariadb": "3.5.4",
    "mongodb": "6.18.0",
    "mysql2": "3.24.3",
    "prettier": "3.9.6",
    "tinyspawn": "1.5.10",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.0",
    "typedoc-plugin-mdn-links": "5.1.1",
    "vitest": "2.0.1",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@aws-sdk/credential-provider-web-identity": "*",
    "ws": ">=8"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/credential-provider-web-identity": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  },
  "engines": {
    "node": ">= 20"
  },
  "scripts": {
    "pretest": "pnpm run build:code",
    "test": "vitest",
    "build": "pnpm run build:code && pnpm run build:docs",
    "build:code": "node ../../utils/build.mjs",
    "build:docs": "typedoc && prettier --write docs/**/*.md docs/*.md"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@vercel/oidc": "workspace:*"
  }
}
