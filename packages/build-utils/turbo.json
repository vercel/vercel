{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "dependsOn": ["build"]
    },
    "test-unit": {
      "dependsOn": ["build"]
    },
    "test-e2e": {
      "command": ["node", "-e", "process.exit(0)"],
      "dependsOn": ["test-e2e:1", "test-e2e:2", "test-e2e:3", "test-e2e:4"]
    },
    "test-e2e:1": {
      "command": ["node", "test/run-integration-group.mjs", "1"],
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/test/lib/**",
        "$TURBO_ROOT$/vitest.config.mts"
      ],
      "outputLogs": "new-only"
    },
    "test-e2e:2": {
      "command": ["node", "test/run-integration-group.mjs", "2"],
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/test/lib/**",
        "$TURBO_ROOT$/vitest.config.mts"
      ],
      "outputLogs": "new-only"
    },
    "test-e2e:3": {
      "command": ["node", "test/run-integration-group.mjs", "3"],
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/test/lib/**",
        "$TURBO_ROOT$/vitest.config.mts"
      ],
      "outputLogs": "new-only"
    },
    "test-e2e:4": {
      "command": ["node", "test/run-integration-group.mjs", "4"],
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/test/lib/**",
        "$TURBO_ROOT$/vitest.config.mts"
      ],
      "outputLogs": "new-only"
    }
  }
}
