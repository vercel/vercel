{
  "probes": [
    { "path": "/api", "status": 200, "mustContain": "Hello, world!" },
    { "path": "/api/app", "status": 200, "mustContain": "Hello, world!" },
    { "path": "/api/app.py", "status": 200, "mustContain": "Hello, world!" },
    { "path": "/api/helper", "status": 404 },
    {
      "path": "/api/another",
      "mustContain": "upper:RANDOMNESS_PLACEHOLDER",
      "responseHeaders": { "content-type": "text/plain" }
    },
    {
      "path": "/api/brackets/[hello].py",
      "mustContain": "hello:RANDOMNESS_PLACEHOLDER",
      "responseHeaders": { "content-type": "text/plain" }
    },
    {
      "path": "/api/brackets/anything",
      "mustContain": "hello:RANDOMNESS_PLACEHOLDER",
      "responseHeaders": { "content-type": "text/plain" }
    },
    { "logMustContain": "Using python version: 3.12" }
  ]
}
