{
  "probes": [
    {
      "path": "/api/as_handler",
      "mustContain": "handler:RANDOMNESS_PLACEHOLDER",
      "responseHeaders": { "content-type": "text/plain" }
    },
    {
      "path": "/api/as_wsgi",
      "mustContain": "wsgi:RANDOMNESS_PLACEHOLDER",
      "responseHeaders": { "content-type": "text/plain" }
    },
    {
      "path": "/api/as_flask",
      "mustContain": "flask:RANDOMNESS_PLACEHOLDER",
      "responseHeaders": { "content-type": "text/html; charset=utf-8" }
    },
    {
      "path": "/api/as_asgi",
      "mustContain": "asgi:RANDOMNESS_PLACEHOLDER",
      "responseHeaders": { "content-type": "text/html" }
    },
    {
      "path": "/api/as_sanic",
      "mustContain": "sanic:RANDOMNESS_PLACEHOLDER",
      "responseHeaders": { "content-type": "text/plain; charset=utf-8" }
    },
    {
      "path": "/api/as_starlette",
      "mustContain": "starlette:RANDOMNESS_PLACEHOLDER",
      "responseHeaders": { "content-type": "text/plain; charset=utf-8" }
    },
    {
      "path": "/api/as_fastapi",
      "method": "POST",
      "body": { "name": "RANDOMNESS_PLACEHOLDER" },
      "mustContain": "{\"name\":\"RANDOMNESS_PLACEHOLDER\"}",
      "responseHeaders": { "content-type": "application/json" }
    },
    { "logMustContain": "Using python version: 3.12" }
  ]
}
