{
  "name": "@vercel/agent-setup",
  "version": "0.1.0",
  "private": true,
  "description": "Headless setup for coding agents: point them at AI Gateway and write their MCP server configs, with previews, backups and install receipts",
  "license": "Apache-2.0",
  "author": "Vercel",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel/vercel.git",
    "directory": "packages/agent-setup"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node ../../utils/build.mjs",
    "test": "vitest run --config ../../vitest.config.mts",
    "test-unit": "vitest run --config ../../vitest.config.mts",
    "type-check": "tsc --noEmit"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "js-yaml": "4.1.1",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.5.2"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "20.11.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
