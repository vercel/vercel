{
  "build": {
    "env": {
      "VERCEL_RUBY_EXPERIMENTAL_BUILDPACK": "1"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "rack"
      }
    }
  ],
  "services": {
    "rack": {
      "root": ".",
      "framework": "ruby",
      "command": "bundle exec rackup --host 0.0.0.0 --port \"$PORT\" config.ru"
    }
  }
}
