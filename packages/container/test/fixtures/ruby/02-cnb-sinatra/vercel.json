{
  "build": {
    "env": {
      "VERCEL_RUBY_EXPERIMENTAL_BUILDPACK": "1"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "sinatra"
      }
    }
  ],
  "services": {
    "sinatra": {
      "root": ".",
      "runtime": "ruby"
    }
  }
}
