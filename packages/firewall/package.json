{
  "name": "@vercel/firewall",
  "description": "Rate limiting via the Vercel Firewall",
  "homepage": "https://vercel.com",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "version": "1.2.4",
  "repository": {
    "directory": "packages/firewall",
    "type": "git",
    "url": "git+https://github.com/vercel/vercel.git"
  },
  "bugs": {
    "url": "https://github.com/vercel/vercel/issues"
  },
  "devDependencies": {
    "@smithy/types": "3.3.0",
    "@types/node": "20.11.0",
    "prettier": "3.8.3",
    "tinyspawn": "1.3.1",
    "typedoc": "0.28.19",
    "typedoc-plugin-markdown": "4.11.0",
    "typedoc-plugin-mdn-links": "5.1.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">= 20"
  },
  "scripts": {
    "pretest": "pnpm run build:code",
    "test-e2e": "vitest run --config ../../vitest.config.mts test/e2e/",
    "build": "pnpm run build:code",
    "build:code": "node ../../utils/build.mjs",
    "build:docs": "typedoc && prettier --write docs/**/*.md docs/*.md",
    "test": "vitest run --config ../../vitest.config.mts"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
