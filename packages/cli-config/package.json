{
  "name": "@vercel/cli-config",
  "version": "0.2.2",
  "description": "Shared core utilities for Vercel global configuration",
  "license": "Apache-2.0",
  "homepage": "https://vercel.com/docs/projects/project-configuration/global-configuration",
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel/vercel.git",
    "directory": "packages/cli-config"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./paths": "./dist/paths.js"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "generate:schemas": "ts-to-zod src/types.ts src/schema.zod.ts",
    "test": "vitest run --config ../../vitest.config.mts test",
    "test-unit": "vitest run --config ../../vitest.config.mts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.1.11",
    "xdg-app-paths": "5"
  },
  "devDependencies": {
    "@types/node": "20.11.0",
    "ts-to-zod": "^3",
    "vite": "6.4.3",
    "vitest": "4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
