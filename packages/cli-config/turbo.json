{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["generate:schemas", "^build"],
      "inputs": ["$TURBO_DEFAULT$", "!src/schema.zod.ts"]
    },
    "generate:schemas": {
      "inputs": ["$TURBO_DEFAULT$", "!src/schema.zod.ts"],
      "outputs": ["src/schema.zod.ts"]
    }
  }
}
