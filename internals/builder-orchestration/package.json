  },
  "devDependencies": {
    "@types/fs-extra": "9.0.13",
    "@types/mime-types": "2.1.0",
    "@types/minimatch": "3.0.3",
    "@types/node": "20.11.0",
    "@types/npm-package-arg": "6.1.0",
    "@types/pluralize": "0.0.29",
    "@types/semver": "6.0.1",
    "@types/yauzl-promise": "2.1.0",
    "@vercel-internals/tsconfig": "workspace:*",
