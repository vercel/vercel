{
  "private": true,
  "name": "@vercel-internals/builder-orchestration",
  "version": "1.0.0",
  "files": [
    "dist"
  ],
  "exports": {
    "./import-builders": {
      "types": "./dist/import-builders.d.ts",
      "default": "./dist/import-builders.js"
    },
    "./install-builders": {
      "types": "./dist/install-builders.d.ts",
      "default": "./dist/install-builders.js"
    },
    "./sort-builders": {
      "types": "./dist/sort-builders.d.ts",
      "default": "./dist/sort-builders.js"
    },
    "./static-builder": {
      "types": "./dist/static-builder.d.ts",
      "default": "./dist/static-builder.js"
    },
    "./write-build-result": {
      "types": "./dist/write-build-result.d.ts",
      "default": "./dist/write-build-result.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/*"
      ]
    }
  },
  "scripts": {
    "build": "node ../../utils/build.mjs",
    "type-check": "tsc --noEmit",
