{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputLogs": "new-only",
      "outputs": ["dist/**", "bin/**"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "test-unit": {
      "dependsOn": ["build"]
    }
  }
}
