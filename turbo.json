{
  "$schema": "https://turborepo.org/schema.json",
  "futureFlags": {
    "affectedUsingTaskInputs": true,
    "strictTaskEntrypointSelection": true,
    "experimentalObservability": true
  },
  "globalDependencies": [".github/workflows/**", "turbo-cache-key.json"],
  "globalEnv": ["OS", "RUNNER_OS"],
  "envMode": "loose",
  "experimentalObservability": {
    "otel": {
      "enabled": true,
      "protocol": "http/protobuf",
      "timeoutMs": 10000,
      "intervalMs": 15000,
      "resource": {
        "service.name": "turborepo"
      },
      "metrics": {
        "runSummary": true,
        "taskDetails": true
      }
    }
  },
  "tasks": {
    "//#format:check": {},
    "//#lint": {},
    "//#lint:dependencies": {},
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/utils/build.mjs",
        "$TURBO_ROOT$/utils/build-builder.mjs"
      ],
      "outputLogs": "new-only",
      "outputs": ["dist/**"]
    },
    "build:docs": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!docs/**"],
      "outputLogs": "new-only",
      "outputs": ["docs/**"]
    },
    "generate:schemas": {
      "outputLogs": "new-only"
    },
    "build:wasm": {
      "outputLogs": "new-only"
    },
    "test-e2e-node-all-versions": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/test/lib/**",
        "$TURBO_ROOT$/vitest.config.mts"
      ],
      "outputLogs": "new-only"
    },
    "test-unit": {
      "dependsOn": ["^build"],
      "env": ["NODE_VERSION", "VITEST_SHARD"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.config.mts"],
      "outputLogs": "new-only"
    },
    "test-dev": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/test/lib/**",
        "$TURBO_ROOT$/vitest.config.mts"
      ],
      "outputLogs": "new-only"
    },
    "test-e2e": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/test/lib/**",
        "$TURBO_ROOT$/vitest.config.mts"
      ],
      "outputLogs": "new-only"
    },
    "test-next-local": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/test/lib/**",
        "$TURBO_ROOT$/vitest.config.mts"
      ],
      "outputLogs": "new-only"
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["VITEST_SHARD", "VITEST_TEST_FILES"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/test/lib/**",
        "$TURBO_ROOT$/vitest.config.mts"
      ],
      "outputLogs": "new-only"
    },
    "type-check": {
      "dependsOn": ["build", "source"]
    },
    "source": {
      "dependsOn": ["^source"]
    }
  }
}
