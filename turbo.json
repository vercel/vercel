{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": [
    ".github/workflows/**",
    "packages/build-utils/src/**",
    "packages/cli/scripts/start.js",
    "pnpm-lock.yaml",
    "turbo-cache-key.json",
    "package.json",
    "test/lib/**",
    "utils/**/*.js",
    "utils/**/*.mjs",
    "vitest.config.mts"
  ],
  "globalEnv": ["OS", "RUNNER_OS"],
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputLogs": "new-only",
      "outputs": ["dist/**"]
    },
    "vitest-unit": {
      "dependsOn": ["build"],
      "env": ["NODE_VERSION", "VITEST_SHARD"],
      "outputLogs": "new-only"
    },
    "vitest-unit-node-24": {
      "dependsOn": ["build"],
      "outputLogs": "new-only"
    },
    "vitest-run": {
      "dependsOn": ["build"],
      "outputLogs": "new-only"
    },
    "vitest-e2e": {
      "dependsOn": ["build"],
      "outputLogs": "new-only"
    },
    "vitest-e2e-node-20": {
      "dependsOn": ["build"],
      "outputLogs": "new-only"
    },
    "test-e2e-node-all-versions": {
      "dependsOn": ["build"],
      "outputLogs": "new-only"
    },
    "test-unit": {
      "dependsOn": ["build"],
      "outputLogs": "new-only"
    },
    "test-dev": {
      "dependsOn": ["build"],
      "outputLogs": "new-only"
    },
    "test-cli": {
      "dependsOn": ["build"],
      "outputLogs": "new-only"
    },
    "test-e2e": {
      "dependsOn": ["build"],
      "outputLogs": "new-only"
    },
    "test-next-local": {
      "dependsOn": ["build"],
      "outputLogs": "new-only"
    },
    "test": {
      "dependsOn": ["build"],
      "outputLogs": "new-only"
    },
    "type-check": {
      "dependsOn": ["source", "^build"]
    },
    "source": {
      "dependsOn": ["^source"]
    }
  }
}
