{
  "$schema": "https://turborepo.org/schema.json",
  "futureFlags": {
    "experimentalObservability": true
  },
  "globalDependencies": [
    ".github/workflows/**",
    "packages/build-utils/src/**",
    "packages/cli/scripts/start.js",
    "pnpm-lock.yaml",
    "turbo-cache-key.json",
    "package.json",
    "test/lib/**",
    "utils/**/*.js",
    "utils/**/*.mjs",
    "vitest.config.mts"
  ],
  "globalEnv": ["OS", "RUNNER_OS"],
  "envMode": "loose",
  "experimentalObservability": {
    "otel": {
      "enabled": true,
      "protocol": "http/protobuf",
      "timeoutMs": 10000,
      "intervalMs": 15000,
      "resource": {
        "service.name": "turborepo"
      },
      "metrics": {
        "runSummary": true,
        "taskDetails": true
      }
    }
  },
  "tasks": {
    "//#format:check": {},
    "//#lint": {},
    "//#lint:dependencies": {},
    "build": {
      "dependsOn": ["^build"],
      "outputLogs": "new-only",
      "outputs": ["dist/**"]
    },
    "test-e2e-node-all-versions": {
      "dependsOn": ["build"],
      "outputLogs": "new-only"
    },
    "test-unit": {
      "dependsOn": ["build"],
      "env": ["NODE_VERSION", "VITEST_SHARD"],
      "outputLogs": "new-only"
    },
    "test-dev": {
      "dependsOn": ["build"],
      "outputLogs": "new-only"
    },
    "test-cli": {
      "dependsOn": ["build"],
      "outputLogs": "new-only"
    },
    "test-e2e": {
      "dependsOn": ["build"],
      "outputLogs": "new-only"
    },
    "test-next-local": {
      "dependsOn": ["build"],
      "outputLogs": "new-only"
    },
    "test": {
      "dependsOn": ["build"],
      "env": ["VITEST_SHARD", "VITEST_TEST_FILES"],
      "outputLogs": "new-only"
    },
    "type-check": {
      "dependsOn": ["build", "source", "^build"]
    },
    "source": {
      "dependsOn": ["^source"]
    }
  }
}
